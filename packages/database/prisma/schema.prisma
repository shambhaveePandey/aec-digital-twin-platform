// Learn more: https://pris.ly/d/prisma-schema
// NOTE: SQLite fallback — enums replaced with String, Json replaced with String (serialised JSON).
// Revert to postgresql provider when Docker/Postgres is available.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth.js Prisma Adapter) ───────────────────────────────────────
// Required by @auth/prisma-adapter. Do not rename fields.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships WorkspaceMember[]
  auditEvents AuditEvent[]

  @@map("users")
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  twins       DigitalTwin[]
  auditEvents AuditEvent[]

  @@map("workspaces")
}

// WorkspaceRole values: OWNER | ADMIN | MEMBER | VIEWER
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

// ─── Digital Twin ─────────────────────────────────────────────────────────────

// TwinStatus values: DRAFT | ACTIVE | ARCHIVED
model DigitalTwin {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  address     String?
  latitude    Float?
  longitude   Float?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  modelVersions TwinModelVersion[]
  files         TwinFile[]
  sensors       Sensor[]
  issues        Issue[]
  viewpoints    Viewpoint[]
  jobs          BackgroundJob[]
  auditEvents   AuditEvent[]

  @@index([workspaceId])
  @@index([status])
  @@map("digital_twins")
}

// ─── Model Versions ───────────────────────────────────────────────────────────

// ModelVersionStatus values: PENDING | PROCESSING | READY | FAILED
model TwinModelVersion {
  id                String    @id @default(cuid())
  twinId            String
  version           Int
  label             String?
  status            String    @default("PENDING")
  ifcFileKey        String?
  ifcFileName       String?
  ifcFileSizeBytes  Int?
  fragFileKey       String?
  fragFileSizeBytes Int?
  elementCount      Int?
  ifcSchema         String?
  boundingBox       String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  twin          DigitalTwin            @relation(fields: [twinId], references: [id], onDelete: Cascade)
  propertyCache ElementPropertyCache[]
  jobs          BackgroundJob[]

  @@unique([twinId, version])
  @@index([twinId])
  @@index([status])
  @@map("twin_model_versions")
}

// ─── Twin Files ───────────────────────────────────────────────────────────────

// TwinFileType values: IFC_SOURCE | FRAGMENT | PREVIEW_IMAGE | DOCUMENT | OTHER
model TwinFile {
  id           String    @id @default(cuid())
  twinId       String
  fileType     String
  name         String
  s3Key        String    @unique
  sizeBytes    Int
  mimeType     String?
  checksum     String?
  uploadedAt   DateTime  @default(now())
  uploadedById String?

  twin DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId])
  @@index([fileType])
  @@map("twin_files")
}

// ─── Element Property Cache ───────────────────────────────────────────────────
// propertySets / classifications stored as serialised JSON strings.

model ElementPropertyCache {
  id             String   @id @default(cuid())
  modelVersionId String
  ifcGuid        String
  expressId      Int
  ifcClass       String
  name           String?
  propertySets   String
  classifications String?
  spatialPath    String?
  createdAt      DateTime @default(now())

  modelVersion TwinModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  @@unique([modelVersionId, ifcGuid])
  @@index([modelVersionId])
  @@index([modelVersionId, ifcClass])
  @@index([ifcGuid])
  @@map("element_property_cache")
}

// ─── Sensors ──────────────────────────────────────────────────────────────────

// SensorStatus values: ACTIVE | INACTIVE | STALE | ERROR
model Sensor {
  id           String    @id @default(cuid())
  twinId       String
  name         String
  description  String?
  unit         String?
  ifcGuid      String?
  expressId    Int?
  mqttTopic    String?
  externalId   String?
  thresholdMin Float?
  thresholdMax Float?
  status       String    @default("ACTIVE")
  lastSeenAt   DateTime?
  lastValue    Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  twin     DigitalTwin     @relation(fields: [twinId], references: [id], onDelete: Cascade)
  readings SensorReading[]

  @@index([twinId])
  @@index([mqttTopic])
  @@index([ifcGuid])
  @@map("sensors")
}

model SensorReading {
  id        String   @id @default(cuid())
  sensorId  String
  value     Float
  unit      String?
  quality   Int?
  timestamp DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, timestamp])
  @@map("sensor_readings")
}

// ─── Issues (BCF-compatible) ──────────────────────────────────────────────────

// IssueStatus values: OPEN | IN_PROGRESS | RESOLVED | CLOSED | WONT_FIX
// IssuePriority values: LOW | MEDIUM | HIGH | CRITICAL
model Issue {
  id           String    @id @default(cuid())
  twinId       String
  title        String
  description  String?
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  assigneeId   String?
  reportedById String?
  ifcGuid      String?
  expressId    Int?
  bcfGuid      String?   @unique
  dueDate      DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  twin       DigitalTwin    @relation(fields: [twinId], references: [id], onDelete: Cascade)
  comments   IssueComment[]
  viewpoints Viewpoint[]

  @@index([twinId])
  @@index([twinId, status])
  @@index([assigneeId])
  @@map("issues")
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("issue_comments")
}

// ─── Viewpoints ───────────────────────────────────────────────────────────────
// Camera fields and guid arrays stored as serialised JSON strings.

model Viewpoint {
  id               String   @id @default(cuid())
  twinId           String
  issueId          String?
  label            String?
  cameraPosition   String
  cameraTarget     String
  cameraUp         String
  isOrthographic   Boolean  @default(false)
  orthographicSize Float?
  hiddenGuids      String?
  selectedGuids    String?
  bcfGuid          String?  @unique
  snapshotKey      String?
  createdAt        DateTime @default(now())

  twin  DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  issue Issue?      @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([twinId])
  @@index([issueId])
  @@map("viewpoints")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

// AuditAction values: CREATE | UPDATE | DELETE | UPLOAD | CONVERT | SHARE | LOGIN | LOGOUT
model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String?
  twinId      String?
  userId      String?
  action      String
  resource    String
  resourceId  String?
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  workspace Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  twin      DigitalTwin? @relation(fields: [twinId], references: [id], onDelete: SetNull)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([twinId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_events")
}

// ─── Background Jobs ──────────────────────────────────────────────────────────

// JobType values: IFC_CONVERT | PROPERTY_EXTRACT | PREVIEW_GENERATE | FRAGMENT_UPLOAD
// JobStatus values: QUEUED | RUNNING | DONE | FAILED | CANCELLED
model BackgroundJob {
  id             String    @id @default(cuid())
  twinId         String?
  modelVersionId String?
  type           String
  status         String    @default("QUEUED")
  priority       Int       @default(0)
  payload        String?
  result         String?
  errorMessage   String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  workerId       String?
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  twin         DigitalTwin?      @relation(fields: [twinId], references: [id], onDelete: SetNull)
  modelVersion TwinModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([twinId])
  @@index([type, status])
  @@index([scheduledAt])
  @@map("background_jobs")
}
