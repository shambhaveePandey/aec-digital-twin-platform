# ─────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/aec_twin_dev?schema=public"
# Direct URL bypasses connection pooler (required for Prisma Migrate)
DIRECT_URL="postgresql://postgres:password@localhost:5432/aec_twin_dev?schema=public"

# ─────────────────────────────────────────────
# Auth (NextAuth.js / Auth.js)
# ─────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional – add the ones you enable)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# Object Storage (S3-compatible: MinIO / AWS / Supabase)
# ─────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="aec-twin-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
# Set to "true" when using path-style buckets (MinIO default)
S3_FORCE_PATH_STYLE="true"

# ─────────────────────────────────────────────
# MQTT / Sensor bridge
# ─────────────────────────────────────────────
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="aec-sensor-bridge"

# ─────────────────────────────────────────────
# WebSocket / Realtime
# ─────────────────────────────────────────────
SOCKET_SERVER_URL="http://localhost:3001"
# Secret for signing socket tokens
SOCKET_SECRET="change-me-in-production"

# ─────────────────────────────────────────────
# IFC Worker service
# ─────────────────────────────────────────────
IFC_WORKER_CONCURRENCY="2"
# Queue backend: "redis" | "pg" (BullMQ vs pg-boss)
JOB_QUEUE_BACKEND="redis"
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# web-ifc WASM (served from /public or CDN)
# ─────────────────────────────────────────────
NEXT_PUBLIC_WASM_PATH="/wasm"

# ─────────────────────────────────────────────
# API / OpenAPI
# ─────────────────────────────────────────────
OPENAPI_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
LOG_LEVEL="info"
# Optional: OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="AEC Digital Twin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"