# ─────────────────────────────────────────────
# Client-side IFC viewer — configuration
# ─────────────────────────────────────────────
# This app is 100% client-side. No database, auth, storage, or broker is used.
# These variables are optional; the defaults work out of the box.

# App metadata
NEXT_PUBLIC_APP_NAME="AEC IFC Viewer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# web-ifc WASM location (served from /public/wasm by default)
NEXT_PUBLIC_WASM_PATH="/wasm"

NODE_ENV="development"
